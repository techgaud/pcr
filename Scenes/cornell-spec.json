{
  "schema": "1.0",
  "name": "cornell-spec",
  "version": "1.1.2",

  // Cornell Box, spec-faithful version. Reproduces the canonical 1984
  // Goral et al. setup (cf. http://www.graphics.cornell.edu/online/box/data.html)
  // as closely as our coordinate system allows:
  //
  //   - Cubic-ish room (Cornell uses 555 x 548 x 559; we use 4 x 4 x 4.03).
  //   - Camera 800 Cornell-units in front of the room's open face,
  //     scaled to 5.77 in our units. Camera at origin, room recedes
  //     from z = -5.77 (front opening) to z = -9.80 (back wall).
  //   - 38 deg vertical FOV (Cornell's published value).
  //   - Tall box: 165^3 wide and deep, 330 high, rotated +17.5 deg around Y
  //     in our frame (matching cornell.json's same convention), back-left.
  //   - Short box: 165^3 cube, rotated -17.5 deg around Y, front-right.
  //   - Light: 130 x 105 ceiling rectangle, centered.
  //
  // Differences from cornell.json:
  //   - cornell.json uses a wider 65 deg FOV with the room at z = 0 .. -6
  //     to fill the frame at our typical camera-at-doorway framing.
  //   - cornell-spec sacrifices that for fidelity to the published data.
  //
  // Plane params for the boxes were generated by a Python helper using
  // Cornell's published vertex list mapped through scale 4/555 and an
  // X-mirror (their canonical reference image has tall box on the
  // viewer's LEFT, which in our +X-right frame means -X).

  "camera": { "position": [0, 0, 0], "fov": 38 },

  // Materials use Cornell's MEASURED spectral data directly via the
  // albedo_spd / emissive_spd fields, not RGB approximations. SPD files
  // live under spd/cornell/ and were transcribed from Cornell's publication
  // (graphics.cornell.edu/online/box/data.html). Tabulated spectra survive
  // multi-bounce diffuse interreflection without the metameric drift that
  // an RGB-upsampled Jakob spectrum exhibits, so the cream walls actually
  // read as cream and the red/green walls retain saturation through the
  // bounces.
  //
  // emissive_scale on the light multiplies the published radiance values
  // (which are in arbitrary units) into scene-appropriate brightness.
  // The Cornell publication's raw values peak at 18.4 at 700 nm; ~5x lifts
  // that to the same visible-luminance range as cornell.json's RGB lights.
  "materials": {
    "white": { "albedo_spd":   "cornell/white-paint" },
    "red":   { "albedo_spd":   "cornell/red-paint" },
    "green": { "albedo_spd":   "cornell/green-paint" },
    "light": { "emissive_spd": "cornell/light", "emissive_scale": 5.0 }
  },

  "primitives": [
    { "type": "plane", "name": "ceiling",
      "origin": [-2, 2, -9.80], "u": [4, 0, 0], "v": [0, 0, 4.03], "material": "white" },
    { "type": "plane", "name": "back-wall",
      "origin": [2, 2, -9.80], "u": [-4, 0, 0], "v": [0, -4, 0], "material": "white" },
    { "type": "plane", "name": "floor",
      "origin": [2, -2, -5.77], "u": [0, 0, -4.03], "v": [-4, 0, 0], "material": "white" },
    { "type": "plane", "name": "right-wall",
      "origin": [2, -2, -5.77], "u": [0, 4, 0], "v": [0, 0, -4.03], "material": "green" },
    { "type": "plane", "name": "left-wall",
      "origin": [-2, -2, -9.80], "u": [0, 4, 0], "v": [0, 0, 4.03], "material": "red" },

    { "type": "plane", "name": "tall-bottom",
      "origin": [-1.4017, -2.0, -8.6882], "u": [1.134, 0, -0.3575], "v": [0.3575, 0, 1.134],
      "material": "white" },
    { "type": "plane", "name": "tall-top",
      "origin": [-1.4017, 0.3782, -8.6882], "u": [1.134, 0, -0.3575], "v": [0.3575, 0, 1.134],
      "material": "white" },
    { "type": "plane", "name": "tall-back",
      "origin": [-1.4017, -2.0, -8.6882], "u": [1.134, 0, -0.3575], "v": [0, 2.378, 0],
      "material": "white" },
    { "type": "plane", "name": "tall-front",
      "origin": [-1.0441, -2.0, -7.5542], "u": [1.134, 0, -0.3575], "v": [0, 2.378, 0],
      "material": "white" },
    { "type": "plane", "name": "tall-left",
      "origin": [-1.4017, -2.0, -8.6882], "u": [0.3575, 0, 1.134], "v": [0, 2.378, 0],
      "material": "white" },
    { "type": "plane", "name": "tall-right",
      "origin": [-0.2677, -2.0, -9.0458], "u": [0.3575, 0, 1.134], "v": [0, 2.378, 0],
      "material": "white" },

    { "type": "plane", "name": "short-bottom",
      "origin": [0.2749, -2.0, -7.7358], "u": [1.134, 0, 0.3575], "v": [-0.3575, 0, 1.134],
      "material": "white" },
    { "type": "plane", "name": "short-top",
      "origin": [0.2749, -0.8109, -7.7358], "u": [1.134, 0, 0.3575], "v": [-0.3575, 0, 1.134],
      "material": "white" },
    { "type": "plane", "name": "short-back",
      "origin": [0.2749, -2.0, -7.7358], "u": [1.134, 0, 0.3575], "v": [0, 1.189, 0],
      "material": "white" },
    { "type": "plane", "name": "short-front",
      "origin": [-0.0827, -2.0, -6.6018], "u": [1.134, 0, 0.3575], "v": [0, 1.189, 0],
      "material": "white" },
    { "type": "plane", "name": "short-left",
      "origin": [0.2749, -2.0, -7.7358], "u": [-0.3575, 0, 1.134], "v": [0, 1.189, 0],
      "material": "white" },
    { "type": "plane", "name": "short-right",
      "origin": [1.4089, -2.0, -7.3782], "u": [-0.3575, 0, 1.134], "v": [0, 1.189, 0],
      "material": "white" },

    // Coplanar with the ceiling (y=2.0). Earlier versions floated the
    // light 0.05 below the ceiling out of misplaced concern about
    // coplanar intersection ties. but the renderer already wins those
    // ties in the light's favor (Renderer pushes plane-kind area lights
    // into _planes ahead of walls). The 0.05 gap let the light's
    // double-sided emission bounce off the ceiling and create a visible
    // halo around the fixture.
    { "type": "plane", "name": "area-light", "light": true,
      "origin": [-0.469, 2.0, -7.41], "u": [0.937, 0, 0], "v": [0, 0, 0.757],
      "material": "light" }
  ]
}
