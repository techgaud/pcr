{
  "schema": "1.0",
  "name": "cornell-bunny",
  "version": "1.0.0",

  // Cornell box with the Stanford bunny replacing the usual sphere. First
  // OBJ-mesh demo scene. Bunny is non-emissive; the ceiling plane stays
  // the only area light (light:true on a mesh lands in phase 3b along
  // with triangle area-light sampling).

  "camera": { "position": [0, 0, 0], "fov": 65 },

  "materials": {
    "cream":      { "albedo": [0.74, 0.74, 0.64] },
    "red":        { "albedo": [0.63, 0.06, 0.05] },
    "green":      { "albedo": [0.13, 0.45, 0.10] },
    "bunny-tan":  { "albedo": [0.85, 0.72, 0.55] },
    "warmlight":  { "emissive": [80.0, 68.0, 48.0] }
  },

  "primitives": [
    { "type": "plane", "name": "ceiling",
      "origin": [-2, 2, -6], "u": [4, 0, 0], "v": [0, 0, 7], "material": "cream" },
    { "type": "plane", "name": "back-wall",
      "origin": [2, 2, -6], "u": [-6, 0, 0], "v": [0, -6, 0], "material": "cream" },
    { "type": "plane", "name": "floor",
      "origin": [2, -2, 0], "u": [0, 0, -7], "v": [-4, 0, 0], "material": "cream" },
    { "type": "plane", "name": "right-wall",
      "origin": [2, -2, 0], "u": [0, 4, 0], "v": [0, 0, -6], "material": "green" },
    { "type": "plane", "name": "left-wall",
      "origin": [-2, -2, -6], "u": [0, 4, 0], "v": [0, 0, 6], "material": "red" },

    // Stanford bunny: 69k triangles. bbox is roughly x in [-0.095, 0.061],
    // y in [0.033, 0.187], z in [-0.062, 0.059] (units arbitrary, treat as
    // meters). Scaled 8x and positioned so feet land on the cornell floor
    // (y=-2), centered laterally and rotated 180° around Y so the bunny
    // faces the camera instead of the back wall.
    { "type": "mesh",
      "file": "../models/stanford-bunny.obj",
      "scale": 8,
      "rotation": [0, 180, 0],
      "position": [0.13, -2.264, -4.5],
      "material": "bunny-tan" },

    { "type": "plane", "name": "area-light", "light": true,
      "origin": [-0.375, 2, -4.25], "u": [0.75, 0, 0], "v": [0, 0, 0.4],
      "material": "warmlight" }
  ]
}
