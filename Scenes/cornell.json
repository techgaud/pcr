{
  "schema": "1.0",
  "name": "cornell",
  "version": "1.1.0",

  // Classic Cornell Box, proportions matched to the canonical Goral-1984
  // reference (cf. http://www.graphics.cornell.edu/online/box/data.html):
  //   tall box  = 0.3W x 0.6H x 0.3D of room (165 x 330 x 165 of 555^3),
  //               rotated +18 deg around Y, back-left.
  //   short box = 0.3W x 0.3H x 0.3D of room (165^3 cube),
  //               rotated -18 deg around Y, front-right.
  //
  // Our room is 4 wide x 4 tall x 6 deep, so: tall = 1.2 x 2.4 x 1.2,
  // short = 1.2^3. Scaled-up from v1.0.0's half-sized boxes that didn't
  // match the canonical reference image.

  "camera": { "position": [0, 0, 0], "fov": 65 },

  "materials": {
    "cream":     { "albedo": [0.74, 0.74, 0.64] },
    "red":       { "albedo": [0.63, 0.06, 0.05] },
    "green":     { "albedo": [0.13, 0.45, 0.10] },
    "warmlight": { "emissive": [80.0, 68.0, 48.0] }
  },

  "primitives": [
    { "type": "plane", "name": "ceiling",
      "origin": [-2, 2, -6], "u": [4, 0, 0], "v": [0, 0, 7], "material": "cream" },
    { "type": "plane", "name": "back-wall",
      "origin": [2, 2, -6], "u": [-6, 0, 0], "v": [0, -6, 0], "material": "cream" },
    { "type": "plane", "name": "floor",
      "origin": [2, -2, 0], "u": [0, 0, -7], "v": [-4, 0, 0], "material": "cream" },
    { "type": "plane", "name": "right-wall",
      "origin": [2, -2, 0], "u": [0, 4, 0], "v": [0, 0, -6], "material": "green" },
    { "type": "plane", "name": "left-wall",
      "origin": [-2, -2, -6], "u": [0, 4, 0], "v": [0, 0, 6], "material": "red" },

    // Tall box. Center (-0.7, -0.8, -4.0), size 1.2 x 2.4 x 1.2, +18 deg.
    // Plane params generated via the regenerate-boxes Python helper in
    // the commit that introduced this; if you change size/center/angle,
    // regenerate rather than hand-edit.
    { "type": "plane", "name": "tall-bottom",
      "origin": [-1.456, -2.0, -4.3852], "u": [1.1413, 0, -0.3708], "v": [0.3708, 0, 1.1413],
      "material": "cream" },
    { "type": "plane", "name": "tall-top",
      "origin": [-1.456, 0.4, -4.3852], "u": [1.1413, 0, -0.3708], "v": [0.3708, 0, 1.1413],
      "material": "cream" },
    { "type": "plane", "name": "tall-back",
      "origin": [-1.456, -2.0, -4.3852], "u": [1.1413, 0, -0.3708], "v": [0, 2.4, 0],
      "material": "cream" },
    { "type": "plane", "name": "tall-front",
      "origin": [-1.0852, -2.0, -3.244], "u": [1.1413, 0, -0.3708], "v": [0, 2.4, 0],
      "material": "cream" },
    { "type": "plane", "name": "tall-left",
      "origin": [-1.456, -2.0, -4.3852], "u": [0.3708, 0, 1.1413], "v": [0, 2.4, 0],
      "material": "cream" },
    { "type": "plane", "name": "tall-right",
      "origin": [-0.3148, -2.0, -4.756], "u": [0.3708, 0, 1.1413], "v": [0, 2.4, 0],
      "material": "cream" },

    // Short box. Center (0.7, -1.4, -2.7), size 1.2 x 1.2 x 1.2, -18 deg.
    { "type": "plane", "name": "short-bottom",
      "origin": [0.3148, -2.0, -3.456], "u": [1.1413, 0, 0.3708], "v": [-0.3708, 0, 1.1413],
      "material": "cream" },
    { "type": "plane", "name": "short-top",
      "origin": [0.3148, -0.8, -3.456], "u": [1.1413, 0, 0.3708], "v": [-0.3708, 0, 1.1413],
      "material": "cream" },
    { "type": "plane", "name": "short-back",
      "origin": [0.3148, -2.0, -3.456], "u": [1.1413, 0, 0.3708], "v": [0, 1.2, 0],
      "material": "cream" },
    { "type": "plane", "name": "short-front",
      "origin": [-0.056, -2.0, -2.3148], "u": [1.1413, 0, 0.3708], "v": [0, 1.2, 0],
      "material": "cream" },
    { "type": "plane", "name": "short-left",
      "origin": [0.3148, -2.0, -3.456], "u": [-0.3708, 0, 1.1413], "v": [0, 1.2, 0],
      "material": "cream" },
    { "type": "plane", "name": "short-right",
      "origin": [1.456, -2.0, -3.0852], "u": [-0.3708, 0, 1.1413], "v": [0, 1.2, 0],
      "material": "cream" },

    { "type": "plane", "name": "area-light", "light": true,
      "origin": [-0.375, 2, -4.25], "u": [0.75, 0, 0], "v": [0, 0, 0.4],
      "material": "warmlight" }
  ]
}
