{
  // Schema version of this file format. The loader rejects mismatched majors,
  // so a 2.x file would not be parsed by a 1.x binary.
  "schema": "1.0",

  // Cornell box with a single sphere on the floor — the in-house variant
  // that shipped as the original "cornell" scene through phase 4. Renamed
  // to cornell-frank when the canonical two-boxes scene took over the
  // "cornell" name. Same geometry, fresh name → version reset to 1.0.0.
  "name": "cornell-frank",
  "version": "1.0.0",

  "camera": {
    "position": [0, 0, 0],
    "fov": 65
  },

  "materials": {
    "cream":      { "albedo": [0.74, 0.74, 0.64] },
    "red":        { "albedo": [0.63, 0.06, 0.05] },
    "green":      { "albedo": [0.13, 0.45, 0.10] },
    "nonemissive":{ "albedo": [0.40, 0.40, 0.30] },
    // Pre-multiplied warm light (1.0, 0.85, 0.6 * 80).
    "warmlight":  { "emissive": [80.0, 68.0, 48.0] }
  },

  "primitives": [
    { "type": "plane", "name": "ceiling",
      "origin": [-2, 2, -6], "u": [4, 0, 0], "v": [0, 0, 7],
      "material": "cream" },

    { "type": "plane", "name": "back-wall",
      "origin": [2, 2, -6], "u": [-6, 0, 0], "v": [0, -6, 0],
      "material": "cream" },

    { "type": "plane", "name": "floor",
      "origin": [2, -2, 0], "u": [0, 0, -7], "v": [-4, 0, 0],
      "material": "cream" },

    { "type": "plane", "name": "right-wall",
      "origin": [2, -2, 0], "u": [0, 4, 0], "v": [0, 0, -6],
      "material": "green" },

    { "type": "plane", "name": "left-wall",
      "origin": [-2, -2, -6], "u": [0, 4, 0], "v": [0, 0, 6],
      "material": "red" },

    { "type": "sphere", "name": "center-sphere",
      "center": [0, -1, -4.5], "radius": 0.75,
      "material": "nonemissive" },

    // Single area light, must be exactly one. Ceiling rectangle.
    { "type": "plane", "name": "area-light", "light": true,
      "origin": [-0.375, 2, -4.25], "u": [0.75, 0, 0], "v": [0, 0, 0.4],
      "material": "warmlight" }
  ]
}
